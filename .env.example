# Copy to .env for local overrides. Defaults in internal/config match this file.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=orders
KAFKA_DLQ_TOPIC=orders.dlq
KAFKA_GROUP_ID=order-processors
POSTGRES_DSN=postgres://orders:orders@localhost:5433/orders?sslmode=disable
API_ADDR=:8080
QUERY_GRPC_ADDR=localhost:9090
QUERY_LISTEN_ADDR=:9090
METRICS_ADDR=:2112
LOG_LEVEL=info

# Pool size. Deliberately modest so pool exhaustion is reachable in an experiment
# rather than hidden behind pgx's core-count-derived default.
POSTGRES_MAX_CONNS=10

# Records the worker persists per database round trip.
#
# 1 is one INSERT per record — the behaviour every measurement in FINDINGS.md was
# taken against. Day 10 measured a single worker's ceiling at roughly
# 1/(database round trip) and named batching as the direct fix; raise this to
# test that claim rather than assert it. See `make batch-matrix`.
WORKER_BATCH_SIZE=1

# ---------------------------------------------------------------------------
# Console (cmd/console) — the web control panel. Not read by any pipeline
# service; see cmd/console/config.go for why it has its own configuration.

# Required. There is no default and no plaintext option, because a console with
# a built-in password looks protected and is not. Generate one with:
#   CONSOLE_PASSWORD='something long' make console-hash
CONSOLE_PASSWORD_HASH=

# 32+ bytes of hex. Without it a random key is generated at boot, which logs you
# out on every restart. Generate one with:
#   openssl rand -hex 32
CONSOLE_SESSION_KEY=

# Loopback by default. Do not bind this to 0.0.0.0 to reach it remotely — put a
# tunnel in front instead, so the buttons are never on a listening port.
CONSOLE_ADDR=127.0.0.1:8081

PROMETHEUS_URL=http://localhost:9091
CONSOLE_PROJECT_DIR=.

# Ceilings on what one button press can ask for. They only ever lower an
# action's own limit, never raise it.
CONSOLE_MAX_LOAD_RATE=20000
CONSOLE_MAX_LOAD_DURATION=60s

# Set both when the console is reached through a tunnel or reverse proxy:
# the first marks the session cookie Secure, the second makes the login
# throttle read X-Forwarded-For instead of the proxy's own address.
CONSOLE_SECURE_COOKIE=true
CONSOLE_TRUSTED_PROXY=true
